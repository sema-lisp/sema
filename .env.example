# Copy to .env (gitignored) and fill in the keys you need. Every value below is a
# placeholder; nothing here is a real credential.
#
# The Jakefile loads .env via @dotenv, resolved against the directory you run
# `jake` from. Run from this repo's root, it loads this repo's .env. Run from the
# sema-lisp/workspace root, it loads the workspace's .env instead.
#
# Used by the live LLM recipes: jake test.llm, jake test.providers,
# jake llm-stress, jake rag-demo, and the #[ignore]d release-gate tests.

# ── Chat providers ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace-me-anthropic-key
OPENAI_API_KEY=replace-me-openai-key
GEMINI_API_KEY=replace-me-gemini-key
MISTRAL_API_KEY=replace-me-mistral-key

# ── Embedding providers (llm/configure-embeddings presets) ───────────────────
NOMIC_API_KEY=replace-me-nomic-key
OPENROUTER_API_KEY=replace-me-openrouter-key
DEEPINFRA_API_KEY=replace-me-deepinfra-key

# Cloudflare Workers AI: an API token with Workers AI access, plus the account ID.
CLOUDFLARE_API_TOKEN=replace-me-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=replace-me-cloudflare-account-id

# Azure OpenAI: the resource endpoint and the embedding deployment name.
AZURE_OPENAI_API_KEY=replace-me-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment
