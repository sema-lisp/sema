; A minimal counter web app.
; Visit http://localhost:3000 — click +/- to update the count.

(define count (mutable-cell/new 0))

(define (page)
  (define n (mutable-cell/get count))
  (http/html
    (format
      "<!DOCTYPE html>
<html lang=\"en\">
<head>
  <meta charset=\"utf-8\">
  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
  <title>Counter</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      background: #f5f5f5;
    }
    h1 { font-size: 1.2rem; color: #555; margin-bottom: 1rem; }
    .count {
      font-size: 6rem;
      font-weight: 700;
      color: #111;
      line-height: 1;
      margin-bottom: 2rem;
    }
    .buttons { display: flex; gap: 1rem; }
    form { display: inline; }
    button {
      font-size: 2rem;
      width: 3.5rem;
      height: 3.5rem;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      background: #111;
      color: #fff;
      transition: opacity 0.15s;
    }
    button:hover { opacity: 0.75; }
    .reset button { background: #ccc; color: #333; font-size: 1rem; width: auto;
                    border-radius: 2rem; padding: 0 1.2rem; height: 2.5rem; }
  </style>
</head>
<body>
  <h1>Counter</h1>
  <div class=\"count\">~a</div>
  <div class=\"buttons\">
    <form method=\"post\" action=\"/decrement\">
      <button type=\"submit\">−</button>
    </form>
    <form method=\"post\" action=\"/increment\">
      <button type=\"submit\">+</button>
    </form>
  </div>
  <br>
  <div class=\"reset\">
    <form method=\"post\" action=\"/reset\">
      <button type=\"submit\">reset</button>
    </form>
  </div>
</body>
</html>"
      n)))

(define (handle-increment _req)
  (mutable-cell/set! count (+ (mutable-cell/get count) 1))
  (http/redirect "/"))

(define (handle-decrement _req)
  (mutable-cell/set! count (- (mutable-cell/get count) 1))
  (http/redirect "/"))

(define (handle-reset _req)
  (mutable-cell/set! count 0)
  (http/redirect "/"))

(define app
  (http/router
    [[:get  "/"          (fn (_req) (page))]
     [:post "/increment" handle-increment]
     [:post "/decrement" handle-decrement]
     [:post "/reset"     handle-reset]]))

(http/serve app
  {:port 3000
   :on-listen (fn (info)
     (println (string/append "Counter running → " (:url info))))})
