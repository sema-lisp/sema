;; grammar-fuzz.sema — a grammar-based fuzzer for Sema, written in Sema.
;;
;; Because Sema is homoiconic, a generated program *is* an ordinary Sema value
;; (a list/vector/atom). That makes two sharp correctness oracles almost free:
;;
;;   1. Round-trip (reader <-> printer):   (= form (read (str form)))
;;      Generates arbitrary valid s-expression *data* and asserts that printing
;;      it and reading it back yields a structurally equal value. Any asymmetry
;;      between the printer and the reader falls straight out. Atoms include
;;      bignums (beyond i64), exact rationals (`a/b`), and complex numbers
;;      (`a+bi`), so a regression in their Display/reader round-trip is caught.
;;
;;   2. Differential value oracle (compiler/VM):  (= expected (eval form))
;;      Generates *well-typed, closed* programs over int / bool / float / string /
;;      list / vector / map, computing their expected value bottom-up *while
;;      generating* them (applying the real ops incrementally). It then `eval`s the
;;      whole nested form — driving the full macro-expand -> lower -> optimize ->
;;      compile -> bytecode-VM pipeline — and compares. A mismatch means the
;;      compiler/optimizer/VM disagrees with straight-line evaluation.
;;
;;      Constructs: arithmetic (+ - * variadic, min/max, mod, abs, unary -),
;;      comparisons, even?/odd?/zero?/positive?/negative?, and/or/not, if, cond,
;;      case, match (incl. binding), multi-binding/mixed-type let, multi-arg
;;      lambdas + application, curried closures, set!, try/throw/catch, apply,
;;      named-let TCO recursion (large N), and list/vector/map/string ops. Int
;;      leaves occasionally widen to a bignum beyond i64, so every int
;;      production above also gets exercised with tower operands; dedicated
;;      "law" cases exercise rational and complex literal arithmetic.
;;      Excluded by design: non-deterministic surfaces (LLM, time, randomness,
;;      uuid, file/network IO, async timing) — no stable oracle.
;;
;; A third failure mode — a hard VM crash (Rust panic; release builds are
;; panic=abort) — is detected by the driver (scripts/grammar-fuzz.sh): before
;; each iteration we write the iteration's seed to SEMA_FUZZ_CRASH_FILE, so if
;; the process dies the driver knows exactly which seed reproduces it.
;;
;; Everything is driven by a small self-contained PRNG so every finding is
;; reproducible from a single integer seed.
;;
;; Configuration (environment variables):
;;   SEMA_FUZZ_SEED        base seed (int, default 0)
;;   SEMA_FUZZ_COUNT       number of iterations / programs (default 200)
;;   SEMA_FUZZ_DEPTH       max generation depth (default 4)
;;   SEMA_FUZZ_MODE        "check" (run oracles, default) or "emit" (print programs)
;;   SEMA_FUZZ_OUT         emit mode: file to write to (default: stdout)
;;   SEMA_FUZZ_CRASH_FILE  check mode: file to record the in-flight seed (crash breadcrumb)
;;   SEMA_FUZZ_VERBOSE     "1" to print every passing form too
;;   SEMA_FUZZ_ASYNC       "1" to enable the async productions (channels with
;;                         small capacities, cancellation, timers, race/timeout)
;;                         and the confluent-value twin oracle (see check-twin).
;;                         Run via scripts/grammar-fuzz.sh --async, which adds an
;;                         external watchdog so a runtime hang becomes a finding.
;;
;; Iteration i uses seed (base + i), and each iteration re-seeds the PRNG, so a
;; failure reported at a given seed reproduces exactly with
;;   SEMA_FUZZ_SEED=<seed> SEMA_FUZZ_COUNT=1
;; (plus SEMA_FUZZ_ASYNC=1 when the async productions were enabled).

;; ─────────────────────────────────────────────────────────────────────────
;; PRNG — PCG-style LCG over wrapping 64-bit integers (deterministic, seedable)
;; ─────────────────────────────────────────────────────────────────────────

(define *rng* 1)

(define (rng-seed! s)
  ;; Scramble the seed through one LCG step before use. The previous version did
  ;; `(bit/or 1 ...)`, which collapsed every adjacent pair of seeds (2k and 2k+1)
  ;; to the same state — and since the driver feeds consecutive seeds (base+i),
  ;; that silently made half of every run an exact duplicate. Diffusing the seed
  ;; here makes adjacent base+i streams fully independent. (The LCG below is
  ;; full-period from any state — Hull-Dobell: A=...005 ≡ 1 mod 4, C odd — so no
  ;; odd-state requirement exists in the first place.)
  (set! *rng*
    (mod (abs (+ (* (+ (abs s) 1) 6364136223846793005) 1442695040888963407))
      9223372036854775806)))

(define (rng-next!)
  (set! *rng* (+ (* *rng* 6364136223846793005) 1442695040888963407))
  *rng*)

(define (rng-int! n)
  ;; uniform-ish in [0, n); uses the high bits of the LCG state
  (if (<= n 1) 0 (mod (abs (bit/shift-right (rng-next!) 17)) n)))

(define (rng-range! lo hi) ; inclusive [lo, hi]
  (+ lo (rng-int! (+ 1 (- hi lo)))))

(define (rng-pick! xs) (nth xs (rng-int! (length xs))))
(define (rng-bool!) (= 0 (rng-int! 2)))

;; ─────────────────────────────────────────────────────────────────────────
;; Datum generator — arbitrary valid s-expression data (for the round-trip test)
;; ─────────────────────────────────────────────────────────────────────────

;; Pools of literal symbols/keywords/chars. Symbols are deliberately "safe"
;; identifiers (no reader-special tokens) so the only thing under test is the
;; printer/reader, not our choice of names.
(define *sym-pool* (list 'a 'b 'c 'foo 'bar 'x 'y 'list 'quote 'do-thing))
(define *kw-pool* (list :a :b :c :foo :bar :k1 :k2 :k3))
(define *char-pool* (list #\a #\Z #\0 #\space #\newline #\tab #\return))
;; String alphabet, including the escape-sensitive characters " \ newline tab —
;; the readable printer now escapes these and the reader parses them back, so the
;; round-trip oracle covers them (this is what regression-guards that fix).
(define *str-alpha* "abcdefghijkRSTUVWXYZ0123456789 -_./:?!()[]{}*+=<>\"\\\n\t")

(define (gen-char-from alpha)
  (let ((k (rng-int! (string-length alpha))))
    (substring alpha k (+ k 1))))

(define (gen-string)
  (let ((len (rng-int! 8)))
    (let loop ((i 0) (acc ""))
      (if (>= i len)
        acc
        (loop (+ i 1) (string-append acc (gen-char-from *str-alpha*)))))))

(define (gen-float)
  ;; k/1000 style values exercise float printing + shortest-round-trip parsing
  (/ (rng-range! -1000000 1000000) 1000.0))

(define (gen-bignum)
  ;; A random integer safely beyond i64::MAX (9223372036854775807): the
  ;; product of two 10-digit factors is at least 1.6e19, always out of i64
  ;; range regardless of sign — exercises the TAG_BIGINT reader/printer path.
  (let ((a (rng-range! 4000000000 9999999999))
        (b (rng-range! 4000000000 9999999999)))
    (if (rng-bool!) (* a b) (- (* a b)))))

(define (gen-rational-atom)
  ;; Bias away from denominator-1 collapse (which would just normalize to an
  ;; integer) so the `a/b` reader/printer path gets real exercise.
  (let* ((d (rng-pick! (list 2 3 5 7 11 13 17 19)))
         (n0 (rng-range! -999 999))
         (n (if (= 0 (mod n0 d)) (+ n0 1) n0)))
    (/ n d)))

(define (gen-complex-atom)
  ;; A nonzero imaginary part so normalization never collapses it to a real —
  ;; exercises the `a+bi` reader/printer path.
  (make-rectangular (rng-range! -50 50) (rng-pick! *nz*)))

(define (gen-atom)
  ((rng-pick! (list
    (lambda () (rng-range! -100000 100000))
    (lambda () (gen-float))
    (lambda () (rng-bool!))
    (lambda () nil)
    (lambda () (gen-string))
    (lambda () (rng-pick! *sym-pool*))
    (lambda () (rng-pick! *kw-pool*))
    (lambda () (rng-pick! *char-pool*))
    (lambda () (gen-bignum))
    (lambda () (gen-rational-atom))
    (lambda () (gen-complex-atom))
    ))))

(define (gen-list depth)
  (let ((k (rng-int! 5)))
    (let loop ((i 0) (acc (list)))
      (if (>= i k)
        (reverse acc)
        (loop (+ i 1) (cons (gen-datum (- depth 1)) acc))))))

(define (gen-vector depth)
  (list->vector (gen-list depth)))

(define (gen-map depth)
  ;; Unique keyword keys (indexed into the pool) so the literal never collapses.
  (let ((k (rng-int! 4)))
    (let loop ((i 0) (m {}))
      (if (>= i k)
        m
        (loop (+ i 1) (assoc m (nth *kw-pool* i) (gen-datum (- depth 1))))))))

(define (gen-datum depth)
  (if (<= depth 0)
    (gen-atom)
    ((rng-pick! (list
      ;; weight 5: atom
      (lambda () (gen-atom))
      (lambda () (gen-atom))
      (lambda () (gen-atom))
      (lambda () (gen-atom))
      (lambda () (gen-atom))
      ;; weight 2: list
      (lambda () (gen-list depth))
      (lambda () (gen-list depth))
      ;; weight 2: vector
      (lambda () (gen-vector depth))
      (lambda () (gen-vector depth))
      ;; weight 1: map
      (lambda () (gen-map depth))
      )))))

;; ─────────────────────────────────────────────────────────────────────────
;; Typed program generator — well-typed, closed int/bool programs (eval oracle)
;;
;; Each generator returns a 2-element list (form expected-value): `form` is the
;; Sema code, `expected-value` is what evaluating it must produce, computed
;; bottom-up during generation.
;;
;; `env` is a list of (symbol value) pairs giving the variables in scope and
;; their known values, so every generated reference is bound and its value known.
;; ─────────────────────────────────────────────────────────────────────────

(define (mk form val) (list form val))
(define (gf p) (nth p 0)) ; the generated form
(define (gv p) (nth p 1)) ; its expected value

;; env entries are (symbol value type), type one of 'int 'bool 'list. Tracking
;; the type lets every generated variable reference be well-typed.
(define (env-of-type env t)
  (filter (lambda (e) (= (nth e 2) t)) env))

;; A (form value) for a random in-scope var of type t, or nil if none exist.
(define (maybe-ref env t)
  (let ((cands (env-of-type env t)))
    (if (pair? cands)
      (let ((b (rng-pick! cands))) (mk (nth b 0) (nth b 1)))
      nil)))

;; Whether the async productions are enabled (SEMA_FUZZ_ASYNC=1). Read here
;; (before *types*) because the type pool depends on it.
(define *async*
  (let ((v (env "SEMA_FUZZ_ASYNC")))
    (and (not (null? v)) (= v "1"))))

;; The set of value types the program generator understands (LLM/network/time/
;; random are deliberately excluded — no deterministic oracle). With the async
;; gate on, 'async entries join the pool, so async programs appear both at the
;; top level and nested anywhere a let binds a random-typed init.
(define *types*
  (let ((base (list 'int 'int 'bool 'list 'float 'string 'vec 'map 'law 'law 'law)))
    (if *async*
      (append base (list 'async 'async 'async 'async 'async))
      base)))

;; Dispatch generation by type.
(define (gen-of t env depth)
  (cond
    ((= t 'int) (gen-int env depth))
    ((= t 'bool) (gen-bool env depth))
    ((= t 'list) (gen-ilist env depth))
    ((= t 'float) (gen-flt env depth))
    ((= t 'string) (gen-str env depth))
    ((= t 'vec) (gen-vec env depth))
    ((= t 'law) (gen-law env depth))
    ((= t 'async) (gen-async env depth))
    (else (gen-map-v env depth))))

;; Nonzero divisor literals for mod (avoids division-by-zero, which raises).
(define *nz* (list 1 2 3 -1 -2 -3 4 -4 7 -7 11 -11))

;; ── int ──────────────────────────────────────────────────────────────────
;; Adapt a uniform (env depth) production to a zero-arg thunk for rng-pick! .
(define (gen-thunk f)
  (lambda (env depth) (f env depth)))

(define (gen-int env depth)
  (if (<= depth 0)
    (gen-int-leaf env)
    ((rng-pick! (list
      ;; slots 0-2: leaf (weight 3 of 26)
      (lambda (env depth) (gen-int-leaf env))
      (lambda (env depth) (gen-int-leaf env))
      (lambda (env depth) (gen-int-leaf env))
      (lambda (env depth) (gen-int-bin '+ env depth +))
      (lambda (env depth) (gen-int-bin '- env depth -))
      (lambda (env depth) (gen-int-bin '* env depth *))
      (gen-thunk gen-int-vararith)
      (gen-thunk gen-int-minmax)
      (gen-thunk gen-int-unary)
      (gen-thunk gen-int-mod)
      (gen-thunk gen-int-if)
      (gen-thunk gen-int-cond)
      (gen-thunk gen-int-let)
      (gen-thunk gen-int-app)
      (gen-thunk gen-int-fromlist)
      (gen-thunk gen-int-recur)
      ;; NOTE: set! is deliberately NOT generated. The value oracle computes
      ;; `expected` bottom-up assuming every sub-expression is referentially
      ;; transparent (same value however many times / whenever evaluated).
      ;; set! is the only impurity in the grammar; combined with async tasks
      ;; or law-style duplication its evaluation count diverges from the
      ;; model, yielding false positives (a depth-7 program reported a 2x
      ;; mismatch that was an oracle artifact, not a VM bug). set! correctness
      ;; is covered by the dual-eval set! tests instead. Slot 16 -> a leaf.
      (lambda (env depth) (gen-int-leaf env))
      (gen-thunk gen-int-try)
      (gen-thunk gen-int-match)
      (gen-thunk gen-int-case)
      (gen-thunk gen-int-apply)
      (gen-thunk gen-int-curry)
      (gen-thunk gen-int-bits)
      (gen-thunk gen-int-asyncsum)
      (gen-thunk gen-int-asyncchan)
      (gen-thunk gen-int-fromcontainer)
      )) env depth)))

(define (gen-int-leaf env)
  (let ((r (maybe-ref env 'int)))
    (cond
      ((and (not (null? r)) (rng-bool!)) r)
      ;; Occasionally leaf into a bignum instead of a small int, so every int
      ;; production (arithmetic, mod, bit ops, comparisons, control flow) also
      ;; gets exercised with operands beyond i64 through the compile/VM oracle.
      ((= 0 (rng-int! 6)) (let ((n (gen-bignum))) (mk n n)))
      (else (let ((n (rng-range! -12 12))) (mk n n))))))

(define (gen-int-bin op env depth f)
  (let ((a (gen-int env (- depth 1))) (b (gen-int env (- depth 1))))
    (mk (list op (gf a) (gf b)) (f (gv a) (gv b)))))

(define (gen-int-vararith env depth)
  (let ((a (gen-int env (- depth 1)))
        (b (gen-int env (- depth 1)))
        (c (gen-int env (- depth 1))))
    (if (rng-bool!)
      (mk (list '+ (gf a) (gf b) (gf c)) (+ (gv a) (gv b) (gv c)))
      (mk (list '* (gf a) (gf b) (gf c)) (* (gv a) (gv b) (gv c))))))

(define (gen-int-minmax env depth)
  (let ((a (gen-int env (- depth 1))) (b (gen-int env (- depth 1))))
    (if (rng-bool!)
      (mk (list 'min (gf a) (gf b)) (min (gv a) (gv b)))
      (mk (list 'max (gf a) (gf b)) (max (gv a) (gv b))))))

(define (gen-int-unary env depth)
  (let ((a (gen-int env (- depth 1))))
    (if (rng-bool!)
      (mk (list '- (gf a)) (- (gv a)))
      (mk (list 'abs (gf a)) (abs (gv a))))))

(define (gen-int-mod env depth)
  (let ((a (gen-int env (- depth 1))) (d (rng-pick! *nz*)))
    (mk (list 'mod (gf a) d) (mod (gv a) d))))

(define (gen-int-if env depth)
  (let ((c (gen-bool env (- depth 1)))
        (t (gen-int env (- depth 1)))
        (e (gen-int env (- depth 1))))
    (mk (list 'if (gf c) (gf t) (gf e)) (if (gv c) (gv t) (gv e)))))

(define (gen-int-cond env depth)
  (let ((c1 (gen-bool env (- depth 1)))
        (e1 (gen-int env (- depth 1)))
        (c2 (gen-bool env (- depth 1)))
        (e2 (gen-int env (- depth 1)))
        (ed (gen-int env (- depth 1))))
    (mk
      (list 'cond
        (list (gf c1) (gf e1))
        (list (gf c2) (gf e2))
        (list 'else (gf ed)))
      (cond ((gv c1) (gv e1)) ((gv c2) (gv e2)) (else (gv ed))))))

;; Multi-binding let where each binding can be any type (so bool/list vars also
;; enter scope), body is an int.
(define (gen-int-let env depth)
  (let* ((v1 (gensym "v"))
         (t1 (rng-pick! *types*))
         (i1 (gen-of t1 env (- depth 1)))
         (v2 (gensym "v"))
         (t2 (rng-pick! *types*))
         (i2 (gen-of t2 env (- depth 1)))
         (env2 (cons (list v1 (gv i1) t1) (cons (list v2 (gv i2) t2) env)))
         (body (gen-int env2 (- depth 1))))
    (mk (list 'let (list (list v1 (gf i1)) (list v2 (gf i2))) (gf body))
      (gv body))))

;; ((lambda (p1 p2) body) a1 a2) — closures + multi-arg application.
(define (gen-int-app env depth)
  (let* ((p1 (gensym "p"))
         (p2 (gensym "p"))
         (a1 (gen-int env (- depth 1)))
         (a2 (gen-int env (- depth 1)))
         (env2 (cons (list p1 (gv a1) 'int) (cons (list p2 (gv a2) 'int) env)))
         (body (gen-int env2 (- depth 1))))
    (mk (list (list 'lambda (list p1 p2) (gf body)) (gf a1) (gf a2))
      (gv body))))

;; Pull an int out of a generated list: length / nth / foldl.
(define (gen-int-fromlist env depth)
  (let* ((l (gen-ilist env (- depth 1))) (lv (gv l)) (c (rng-int! 3)))
    (cond
      ((= c 0) (mk (list 'length (gf l)) (length lv)))
      ((= c 1)
        (if (> (length lv) 0)
          (let ((idx (rng-int! (length lv))))
            (mk (list 'nth (gf l) idx) (nth lv idx)))
          (let ((n (rng-range! -9 9))) (mk n n))))
      (else
        (if (rng-bool!)
          (mk (list 'foldl '+ 0 (gf l)) (foldl + 0 lv))
          (mk (list 'foldl '* 1 (gf l)) (foldl * 1 lv)))))))

;; Tail-recursive sum 1..N via named let — stresses TCO at large N. If TCO is
;; broken this overflows the stack (caught as an eval error / crash).
(define (sum-to n)
  (let loop ((i n) (acc 0))
    (if (> i 0) (loop (- i 1) (+ acc i)) acc)))

(define (gen-int-recur env depth)
  (let* ((loop (gensym "loop"))
         (i (gensym "i"))
         (acc (gensym "acc"))
         (n (rng-range! 1 40000)))
    (mk
      (list 'let
        loop
        (list (list i n) (list acc 0))
        (list 'if
          (list '> i 0)
          (list loop (list '- i 1) (list '+ acc i))
          acc))
      (sum-to n))))

;; ── bool ─────────────────────────────────────────────────────────────────
(define (gen-bool env depth)
  (if (<= depth 0)
    (gen-bool-leaf env)
    ((rng-pick! (list
      ;; slots 0-1: leaf (weight 2 of 17)
      (lambda (env depth) (gen-bool-leaf env))
      (lambda (env depth) (gen-bool-leaf env))
      (lambda (env depth) (gen-bool-cmp '= env depth =))
      (lambda (env depth) (gen-bool-cmp '< env depth <))
      (lambda (env depth) (gen-bool-cmp '> env depth >))
      (lambda (env depth) (gen-bool-cmp '<= env depth <=))
      (lambda (env depth) (gen-bool-cmp '>= env depth >=))
      (gen-thunk gen-bool-logic)
      (gen-thunk gen-bool-not)
      (gen-thunk gen-bool-pred)
      (gen-thunk gen-bool-if)
      (gen-thunk gen-bool-floatcmp)
      (gen-thunk gen-bool-mapcontains)
      (gen-thunk gen-bool-typepred)
      (gen-thunk gen-bool-strcontains)
      (gen-thunk gen-law)
      (gen-thunk gen-bool-let)
      )) env depth)))

(define (gen-bool-leaf env)
  (let ((r (maybe-ref env 'bool)))
    (if (and (not (null? r)) (rng-bool!))
      r
      (let ((b (rng-bool!))) (mk b b)))))

(define (gen-bool-cmp op env depth f)
  (let ((a (gen-int env (- depth 1))) (b (gen-int env (- depth 1))))
    (mk (list op (gf a) (gf b)) (f (gv a) (gv b)))))

(define (gen-bool-logic env depth)
  (let ((x (gen-bool env (- depth 1)))
        (y (gen-bool env (- depth 1)))
        (c (rng-int! 3)))
    (cond
      ((= c 0) (mk (list 'and (gf x) (gf y)) (and (gv x) (gv y))))
      ((= c 1) (mk (list 'or (gf x) (gf y)) (or (gv x) (gv y))))
      (else
        (let ((z (gen-bool env (- depth 1))))
          (mk (list 'and (gf x) (gf y) (gf z))
            (and (gv x) (gv y) (gv z))))))))

(define (gen-bool-not env depth)
  (let ((x (gen-bool env (- depth 1))))
    (mk (list 'not (gf x)) (not (gv x)))))

(define (gen-bool-pred env depth)
  (let ((a (gen-int env (- depth 1))) (c (rng-int! 5)))
    (cond
      ((= c 0) (mk (list 'even? (gf a)) (even? (gv a))))
      ((= c 1) (mk (list 'odd? (gf a)) (odd? (gv a))))
      ((= c 2) (mk (list 'zero? (gf a)) (zero? (gv a))))
      ((= c 3) (mk (list 'positive? (gf a)) (positive? (gv a))))
      (else (mk (list 'negative? (gf a)) (negative? (gv a)))))))

(define (gen-bool-if env depth)
  (let ((c (gen-bool env (- depth 1)))
        (t (gen-bool env (- depth 1)))
        (e (gen-bool env (- depth 1))))
    (mk (list 'if (gf c) (gf t) (gf e)) (if (gv c) (gv t) (gv e)))))

(define (gen-bool-let env depth)
  (let* ((v (gensym "v"))
         (init (gen-int env (- depth 1)))
         (env2 (cons (list v (gv init) 'int) env))
         (body (gen-bool env2 (- depth 1))))
    (mk (list 'let (list (list v (gf init))) (gf body)) (gv body))))

;; ── list (of ints) ─────────────────────────────────────────────────────────
(define (gen-ilist env depth)
  (if (<= depth 0)
    (gen-list-leaf env)
    ((rng-pick! (list
      ;; slots 0-2: leaf (weight 3 of 17)
      (lambda (env depth) (gen-list-leaf env))
      (lambda (env depth) (gen-list-leaf env))
      (lambda (env depth) (gen-list-leaf env))
      (gen-thunk gen-list-cons)
      (gen-thunk gen-list-reverse)
      (gen-thunk gen-list-append)
      (gen-thunk gen-list-map)
      (gen-thunk gen-list-filter)
      (gen-thunk gen-list-range)
      (gen-thunk gen-list-rest)
      (gen-thunk gen-list-take)
      (gen-thunk gen-list-drop)
      (gen-thunk gen-list-sort)
      (gen-thunk gen-list-vals)
      (gen-thunk gen-list-fromvec)
      (gen-thunk gen-list-asyncall)
      (gen-thunk gen-list-let)
      )) env depth)))

(define (gen-list-leaf env)
  (let ((r (maybe-ref env 'list)))
    (if (and (not (null? r)) (rng-bool!))
      r
      (let ((k (rng-int! 5)))
        (let loop ((i 0) (fs (list)) (vs (list)))
          (if (>= i k)
            (mk (cons 'list (reverse fs)) (reverse vs))
            (let ((n (rng-range! -9 9)))
              (loop (+ i 1) (cons n fs) (cons n vs)))))))))

(define (gen-list-cons env depth)
  (let ((x (gen-int env (- depth 1))) (l (gen-ilist env (- depth 1))))
    (mk (list 'cons (gf x) (gf l)) (cons (gv x) (gv l)))))

(define (gen-list-reverse env depth)
  (let ((l (gen-ilist env (- depth 1))))
    (mk (list 'reverse (gf l)) (reverse (gv l)))))

(define (gen-list-append env depth)
  (let ((a (gen-ilist env (- depth 1))) (b (gen-ilist env (- depth 1))))
    (mk (list 'append (gf a) (gf b)) (append (gv a) (gv b)))))

;; map with a closed, simple lambda — expected computed by applying the matching
;; real function to the known list value.
(define (gen-list-map env depth)
  (let* ((l (gen-ilist env (- depth 1)))
         (lv (gv l))
         (k (rng-range! -5 5))
         (c (rng-int! 3)))
    (cond
      ((= c 0)
        (mk (list 'map (list 'lambda (list 'x) (list '+ 'x k)) (gf l))
          (map (lambda (x) (+ x k)) lv)))
      ((= c 1)
        (mk (list 'map (list 'lambda (list 'x) (list '* 'x k)) (gf l))
          (map (lambda (x) (* x k)) lv)))
      (else
        (mk (list 'map (list 'lambda (list 'x) (list 'abs 'x)) (gf l))
          (map (lambda (x) (abs x)) lv))))))

(define (gen-list-filter env depth)
  (let* ((l (gen-ilist env (- depth 1))) (lv (gv l)) (c (rng-int! 3)))
    (cond
      ((= c 0) (mk (list 'filter 'even? (gf l)) (filter even? lv)))
      ((= c 1) (mk (list 'filter 'odd? (gf l)) (filter odd? lv)))
      (else
        (let ((k (rng-range! -5 5)))
          (mk (list 'filter (list 'lambda (list 'x) (list '> 'x k)) (gf l))
            (filter (lambda (x) (> x k)) lv)))))))

(define (gen-list-range env depth)
  (let* ((lo (rng-range! -5 5)) (hi (rng-range! lo (+ lo 8))))
    (mk (list 'range lo hi) (range lo hi))))

(define (gen-list-rest env depth)
  (let* ((l (gen-ilist env (- depth 1))) (lv (gv l)))
    (if (> (length lv) 0)
      (mk (list 'rest (gf l)) (rest lv))
      (mk (gf l) lv))))

(define (gen-list-let env depth)
  (let* ((v (gensym "v"))
         (init (gen-int env (- depth 1)))
         (env2 (cons (list v (gv init) 'int) env))
         (body (gen-ilist env2 (- depth 1))))
    (mk (list 'let (list (list v (gf init))) (gf body)) (gv body))))

;; ── int productions over the richer types + control forms ──────────────────

;; (set! removed — see the dispatch note in gen-int: it breaks the value
;; oracle's referential-transparency assumption.)

;; (try BODY (catch e HANDLER)) — either BODY always throws (=> HANDLER) or never
;; throws (=> BODY). HANDLER does not reference e, so its value is deterministic.
(define (gen-int-try env depth)
  (let ((h (gen-int env (- depth 1))) (e (gensym "e")))
    (if (rng-bool!)
      (let ((thrown (gen-int env (- depth 1))))
        (mk (list 'try (list 'throw (gf thrown)) (list 'catch e (gf h)))
          (gv h)))
      (let ((body (gen-int env (- depth 1))))
        (mk (list 'try (gf body) (list 'catch e (gf h)))
          (gv body))))))

;; (match V (lit r) ... (x BODY))  — V is an int; last clause binds, so total.
(define (gen-int-match env depth)
  (let* ((scrut (gen-int env (- depth 1)))
         (sv (gv scrut))
         (k1 (rng-range! -6 6))
         (r1 (gen-int env (- depth 1)))
         (k2 (rng-range! -6 6))
         (r2 (gen-int env (- depth 1)))
         (bn (gensym "m"))
         (rb (gen-int (cons (list bn sv 'int) env) (- depth 1))))
    (mk
      (list 'match
        (gf scrut)
        (list k1 (gf r1))
        (list k2 (gf r2))
        (list bn (gf rb)))
      (cond
        ((= sv k1) (gv r1))
        ((= sv k2) (gv r2))
        (else (gv rb))))))

;; (case V ((k1) r1) ((k2) r2) (else rd))
(define (gen-int-case env depth)
  (let* ((scrut (gen-int env (- depth 1)))
         (sv (gv scrut))
         (k1 (rng-range! -6 6))
         (r1 (gen-int env (- depth 1)))
         (k2 (rng-range! -6 6))
         (r2 (gen-int env (- depth 1)))
         (rd (gen-int env (- depth 1))))
    (mk
      (list 'case
        (gf scrut)
        (list (list k1) (gf r1))
        (list (list k2) (gf r2))
        (list 'else (gf rd)))
      (cond
        ((= sv k1) (gv r1))
        ((= sv k2) (gv r2))
        (else (gv rd))))))

;; (apply OP list-form) for OP in {+ *} — exercises apply + variadic dispatch.
(define (gen-int-apply env depth)
  (let* ((l (gen-ilist env (- depth 1))) (lv (gv l)))
    (if (rng-bool!)
      (mk (list 'apply '+ (gf l)) (apply + lv))
      (mk (list 'apply '* (gf l)) (apply * lv)))))

;; (((lambda (a) (lambda (b) (+ a b))) A) B) — curried/nested closures.
(define (gen-int-curry env depth)
  (let* ((a1 (gen-int env (- depth 1)))
         (a2 (gen-int env (- depth 1)))
         (pa (gensym "a"))
         (pb (gensym "b")))
    (mk
      (list
        (list
          (list 'lambda
            (list pa)
            (list 'lambda (list pb) (list '+ pa pb)))
          (gf a1))
        (gf a2))
      (+ (gv a1) (gv a2)))))

;; Pull an int out of a vec / string / map.
(define (gen-int-fromcontainer env depth)
  ((rng-pick! (list
    (lambda (env depth)
      (let* ((v (gen-vec env (- depth 1))) (vv (gv v)))
        (if (> (count vv) 0)
          (let ((i (rng-int! (count vv))))
            (mk (list 'nth (gf v) i) (nth vv i)))
          (mk (list 'count (gf v)) (count vv)))))
    (lambda (env depth)
      (let ((v (gen-vec env (- depth 1))))
        (mk (list 'count (gf v)) (count (gv v)))))
    (lambda (env depth)
      (let ((s (gen-str env (- depth 1))))
        (mk (list 'string-length (gf s)) (string-length (gv s)))))
    (lambda (env depth)
      (let ((m (gen-map-v env (- depth 1))))
        (mk (list 'count (gf m)) (count (gv m)))))
    (lambda (env depth)
      (let* ((l (gen-ilist env (- depth 1))) (lv (gv l)))
        ;; last of a nonempty list; fall back to length when empty
        (if (> (length lv) 0)
          (mk (list 'last (gf l)) (last lv))
          (mk (list 'length (gf l)) (length lv)))))
    (lambda (env depth)
      (let* ((m (gen-map-v env (- depth 1)))
             (mv (gv m))
             (d (rng-range! -9 9)))
        ;; get with default: deterministic regardless of key presence
        (mk (list 'get (gf m) :zzz d) (get mv :zzz d))))
    )) env depth))

;; ── bit ops + expt (int) ─────────────────────────────────────────────────────
(define (gen-int-bits env depth)
  (let ((a (gen-int env (- depth 1))) (c (rng-int! 7)))
    (cond
      ((= c 0)
        (let ((b (gen-int env (- depth 1))))
          (mk (list 'bit/and (gf a) (gf b)) (bit/and (gv a) (gv b)))))
      ((= c 1)
        (let ((b (gen-int env (- depth 1))))
          (mk (list 'bit/or (gf a) (gf b)) (bit/or (gv a) (gv b)))))
      ((= c 2)
        (let ((b (gen-int env (- depth 1))))
          (mk (list 'bit/xor (gf a) (gf b)) (bit/xor (gv a) (gv b)))))
      ((= c 3)
        (let ((s (rng-int! 16)))
          (mk (list 'bit/shift-left (gf a) s) (bit/shift-left (gv a) s))))
      ((= c 4)
        (let ((s (rng-int! 16)))
          (mk (list 'bit/shift-right (gf a) s) (bit/shift-right (gv a) s))))
      ((= c 5) (mk (list 'bit/not (gf a)) (bit/not (gv a))))
      (else
        (let ((base (rng-range! -4 4)) (e (rng-int! 7)))
          (mk (list 'expt base e) (expt base e)))))))

;; ── bool: type predicates over a random-typed value; string membership ───────
(define (gen-bool-typepred env depth)
  (let* ((v (gen-of (rng-pick! *types*) env (- depth 1)))
         (vv (gv v))
         (c (rng-int! 6)))
    (cond
      ((= c 0) (mk (list 'string? (gf v)) (string? vv)))
      ((= c 1) (mk (list 'list? (gf v)) (list? vv)))
      ((= c 2) (mk (list 'map? (gf v)) (map? vv)))
      ((= c 3) (mk (list 'vector? (gf v)) (vector? vv)))
      ((= c 4) (mk (list 'bool? (gf v)) (bool? vv)))
      (else (mk (list 'nil? (gf v)) (nil? vv))))))

(define (gen-bool-strcontains env depth)
  (let ((s (gen-str env (- depth 1))) (sub (gen-str env (- depth 1))))
    (mk (list 'string/contains? (gf s) (gf sub))
      (string/contains? (gv s) (gv sub)))))

;; ── list: take / drop / sort / vals(of map) / vector->list ───────────────────
(define (gen-list-take env depth)
  (let* ((l (gen-ilist env (- depth 1)))
         (lv (gv l))
         (n (rng-int! (+ 1 (length lv)))))
    (mk (list 'take n (gf l)) (take n lv))))

(define (gen-list-drop env depth)
  (let* ((l (gen-ilist env (- depth 1)))
         (lv (gv l))
         (n (rng-int! (+ 1 (length lv)))))
    (mk (list 'drop n (gf l)) (drop n lv))))

(define (gen-list-sort env depth)
  (let ((l (gen-ilist env (- depth 1))))
    (mk (list 'sort (gf l)) (sort (gv l)))))

(define (gen-list-vals env depth)
  (let ((m (gen-map-v env (- depth 1))))
    (mk (list 'vals (gf m)) (vals (gv m)))))

(define (gen-list-fromvec env depth)
  (let ((v (gen-vec env (- depth 1))))
    (mk (list 'vector->list (gf v)) (vector->list (gv v)))))

;; ── string: repeat / number->string ─────────────────────────────────────────
(define (gen-str-repeat env depth)
  (let ((s (gen-str env (- depth 1))) (n (rng-int! 4)))
    (mk (list 'string/repeat (gf s) n) (string/repeat (gv s) n))))

(define (gen-str-numstr env depth)
  (let ((x (gen-int env (- depth 1))))
    (mk (list 'number->string (gf x)) (number->string (gv x)))))

;; ── map: merge ───────────────────────────────────────────────────────────────
(define (gen-map-merge env depth)
  (let ((a (gen-map-v env (- depth 1))) (b (gen-map-v env (- depth 1))))
    (mk (list 'merge (gf a) (gf b)) (merge (gv a) (gv b)))))

;; ── async / channels (deterministic patterns only) ───────────────────────────
;; Sema's scheduler is cooperative + FIFO, so these are deterministic. We only
;; generate patterns whose result is oracle-computable regardless of interleaving:
;; async/all preserves order; channel fan-in is reduced order-independently (sum).
;; Excluded: async/sleep, async/timeout, async/race, cancellation — real-time /
;; schedule-order dependent, no stable value oracle.

;; (foldl + 0 (async/all (list (async T1) (async T2) ...)))  => sum of task values.
;; Task bodies are ordinary closed-over int programs; async captures outer locals.
(define (gen-int-asyncsum env depth)
  (let ((k (rng-range! 1 4)))
    (let loop ((i 0) (tasks (list)) (sum 0))
      (if (>= i k)
        (mk (list 'foldl '+ 0 (list 'async/all (cons 'list (reverse tasks))))
          sum)
        (let ((t (gen-int env (- depth 1))))
          (loop (+ i 1) (cons (list 'async (gf t)) tasks) (+ sum (gv t))))))))

;; Channel fan-in: spawn k senders, drive them with async/all, then drain+sum.
;; Order-independent reduction => expected is the sum no matter the recv order.
(define (gen-int-asyncchan env depth)
  (let ((k (rng-range! 1 5))
        (ch (gensym "ch"))
        (lp (gensym "loop"))
        (kk (gensym "k"))
        (acc (gensym "acc")))
    (let loop ((i 0) (senders (list)) (sum 0))
      (if (>= i k)
        (mk
          (list 'let
            (list (list ch (list 'channel/new 64)))
            (list 'async/all (cons 'list (reverse senders)))
            (list 'let
              lp
              (list (list kk 0) (list acc 0))
              (list 'if
                (list '>= kk k)
                acc
                (list lp
                  (list '+ kk 1)
                  (list '+ acc (list 'channel/recv ch))))))
          sum)
        (let ((v (gen-int env (- depth 1))))
          (loop (+ i 1)
            (cons (list 'async (list 'channel/send ch (gf v))) senders)
            (+ sum (gv v))))))))

;; (async/all (list (async T1) (async T2) ...))  => (v1 v2 ...) in spawn order.
(define (gen-list-asyncall env depth)
  (let ((k (rng-range! 1 4)))
    (let loop ((i 0) (tasks (list)) (vals (list)))
      (if (>= i k)
        (mk (list 'async/all (cons 'list (reverse tasks))) (reverse vals))
        (let ((t (gen-int env (- depth 1))))
          (loop (+ i 1) (cons (list 'async (gf t)) tasks) (cons (gv t) vals)))))))

;; ── gated async productions (SEMA_FUZZ_ASYNC=1) ─────────────────────────────
;; These exercise the runtime paths the always-on async productions above avoid:
;; small-capacity channels that park senders and receivers, channel/close waking
;; parked tasks, cancellation, timers, race/timeout, and offloaded blocking ops.
;; Every production keeps two invariants (docs/plans/archive/2026-07-29-async-grammar-fuzzer.md):
;;
;;   * Confluence by construction — the value is independent of interleaving:
;;     order-independent reductions (sum), deterministic winners (exactly one
;;     non-parked candidate), value-neutral effects (sleeps, cancelled losers),
;;     and post-settle reads only. In particular `async/cancelled?` is read only
;;     AFTER awaiting the cancelled promise: `async/cancel` is a request, and
;;     immediately after it the predicate's answer depends on whether the target
;;     had started yet (verified against the binary: a cancel of a parked task
;;     reads #f before the await and #t after).
;;   * Termination by construction — sends and recvs are balanced, or the
;;     imbalance is resolved by a close or cancel the generator also emits;
;;     sleeps are <= 5 ms; capacities are 1-3 (small enough to park senders,
;;     never enough to deadlock a balanced program). The driver watchdog is a
;;     net for runtime bugs, not a crutch for generator bugs.
;;
;; Oracle class per async production (phase 2 of the plan). A "twin" production
;; is also checked by the confluent-value twin oracle (check-twin below): the
;; program is mechanically de-asynced and the sequential twin must produce the
;; same expected value, so a bug in the generation-time model cannot self-mask.
;; A "model" production has no mechanical sequential twin — its oracle is the
;; generation-time expected value plus the #t laws embedded in the form
;; (cancelled?, closed?, the caught error marker, the race-winner identity).
;; Twinning is whole-program: one non-mechanical construct anywhere in a
;; generated program skips the twin for that program (counted as
;; non-mechanical in the end-of-run stat line). New productions must add a row
;; here and, if they introduce a new async op, teach the walker about it —
;; unknown async/* and channel/* heads block by default, never mistwin.
;;
;;   production                 class  twin rationale
;;   gen-int-asyncsum           twin   async/all over (async ...) tasks -> list of bodies
;;   gen-list-asyncall          twin   async/all over (async ...) tasks -> list of bodies
;;   gen-async-leaf             twin   await of a spawned pure body -> the body
;;   gen-async-spawn-tree       twin   spawn + await tree of pure bodies -> direct calls
;;   gen-async-owned-ok         twin   async/map, async/pool-map -> map; spawn-all -> called thunks
;;   gen-int-asyncchan          model  channel ops park; no sequential equivalent
;;   gen-async-chan-pipeline    model  same
;;   gen-async-chan-recvfirst   model  same
;;   gen-async-chan-fanin       model  same
;;   gen-async-chan-close       model  close/closed? law is about channel state
;;   gen-async-chan-closewake   model  close-wakes-receiver law
;;   gen-async-chan-closesend   model  close-fails-parked-send error path
;;   gen-async-tryrecv          model  try-recv reads channel state
;;   gen-async-cancel           model  cancellation has no sequential equivalent
;;   gen-async-owned-fail       model  fail-fast cancels siblings; plain map would not
;;   gen-async-race             model  a race needs a scheduler
;;   gen-async-with-timeout     model  same
;;   gen-async-causal           model  the law is about interleaving itself
;;   gen-async-offload          model  twin would repeat file I/O side effects

;; Optionally prefix task body forms with a value-neutral sleep. `async/sleep`
;; parks on a virtual timer; blocking `sleep` parks via the offload executor —
;; two distinct wait kinds.
(define (with-sleeps body-forms)
  ((rng-pick! (list
    (lambda () (cons (list 'async/sleep (rng-int! 6)) body-forms))
    (lambda () (cons (list 'sleep (rng-int! 4)) body-forms))
    (lambda () body-forms)
    (lambda () body-forms)
    ))))

;; A task form: (async <maybe-sleep> body...).
(define (mk-task body-forms)
  (cons 'async (with-sleeps body-forms)))

;; Form draining exactly k values from channel ch (a symbol) and summing them.
(define (drain-sum-form ch k)
  (let ((lp (gensym "dr")) (i (gensym "i")) (acc (gensym "acc")))
    (list 'let
      lp
      (list (list i 0) (list acc 0))
      (list 'if
        (list '>= i k)
        acc
        (list lp (list '+ i 1) (list '+ acc (list 'channel/recv ch)))))))

;; Leaf: the smallest async form, used when depth is exhausted.
(define (gen-async-leaf env)
  (let ((t (gen-int env 0)))
    (mk (list 'async/await (list 'async (gf t))) (gv t))))

;; Blocking pipeline, sender variant: one sender task pushes k ints through a
;; capacity-cap channel (cap is often < k, so the sender parks on a full
;; buffer); the root drains exactly k, sums, then reaps the sender. Draining
;; BEFORE awaiting keeps the program deadlock-free: awaiting first would block
;; the only consumer while the sender is parked (the runtime's deadlock
;; detector rightly rejects that shape).
(define (gen-async-chan-pipeline env depth)
  (let ((cap (rng-range! 1 3))
        (k (rng-range! 1 5))
        (ch (gensym "ch"))
        (s (gensym "s"))
        (total (gensym "t")))
    (let loop ((j 0) (sends (list)) (sum 0))
      (if (< j k)
        (let ((v (gen-int env (- depth 1))))
          (loop (+ j 1) (cons (list 'channel/send ch (gf v)) sends) (+ sum (gv v))))
        (mk
          (list 'let
            (list (list ch (list 'channel/new cap)))
            (list 'let
              (list (list s (mk-task (reverse sends))))
              (list 'let
                (list (list total (drain-sum-form ch k)))
                (list 'async/await s)
                total)))
          sum)))))

;; Blocking pipeline, receiver variant: the task drains k values (parking first
;; on the empty channel) while the root sends; with cap < k the ROOT parks on a
;; full buffer mid-send. Awaiting the receiver returns the sum.
(define (gen-async-chan-recvfirst env depth)
  (let ((cap (rng-range! 1 3))
        (k (rng-range! 1 5))
        (ch (gensym "ch"))
        (r (gensym "r")))
    (let loop ((j 0) (sends (list)) (sum 0))
      (if (< j k)
        (let ((v (gen-int env (- depth 1))))
          (loop (+ j 1) (cons (list 'channel/send ch (gf v)) sends) (+ sum (gv v))))
        (mk
          (list 'let
            (list (list ch (list 'channel/new cap)))
            (cons 'let
              (cons (list (list r (mk-task (list (drain-sum-form ch k)))))
                (append (reverse sends) (list (list 'async/await r))))))
          sum)))))

;; Multi-sender fan-in: m sender tasks share one small channel; the root drains
;; the combined count and sums. The recv order across senders is scheduler-
;; dependent, so the reduction must stay order-independent (sum). Senders are
;; awaited only after the drain, for the same deadlock-freedom reason as the
;; pipeline.
(define (gen-async-chan-fanin env depth)
  (let ((cap (rng-range! 1 3))
        (m (rng-range! 2 3))
        (ch (gensym "ch"))
        (total (gensym "t")))
    (let sloop ((si 0) (names (list)) (tasks (list)) (kk 0) (sum 0))
      (if (< si m)
        (let ((k (rng-range! 1 3)))
          (let vloop ((j 0) (sends (list)) (s2 sum))
            (if (< j k)
              (let ((v (gen-int env (- depth 1))))
                (vloop (+ j 1) (cons (list 'channel/send ch (gf v)) sends) (+ s2 (gv v))))
              (let ((nm (gensym "s")))
                (sloop (+ si 1)
                  (cons nm names)
                  (cons (list nm (mk-task (reverse sends))) tasks)
                  (+ kk k)
                  s2)))))
        (mk
          (list 'let
            (list (list ch (list 'channel/new cap)))
            (list 'let
              (reverse tasks)
              (cons 'let
                (cons (list (list total (drain-sum-form ch kk)))
                  (append
                    (map (lambda (nm) (list 'async/await nm)) (reverse names))
                    (list total))))))
          sum)))))

;; Producer sends k then closes; the root drains exactly k, awaits the producer
;; (so the close has settled), then checks the close is observable:
;; `channel/closed?` is #t and a recv on the closed, empty channel is nil.
(define (gen-async-chan-close env depth)
  (let ((cap (rng-range! 1 3))
        (k (rng-range! 1 4))
        (ch (gensym "ch"))
        (s (gensym "s"))
        (total (gensym "t")))
    (let loop ((j 0) (sends (list)) (sum 0))
      (if (< j k)
        (let ((v (gen-int env (- depth 1))))
          (loop (+ j 1) (cons (list 'channel/send ch (gf v)) sends) (+ sum (gv v))))
        (mk
          (list 'let
            (list (list ch (list 'channel/new cap)))
            (list 'let
              (list
                (list s
                  (mk-task
                    (append (reverse sends) (list (list 'channel/close ch))))))
              (list 'let
                (list (list total (drain-sum-form ch k)))
                (list 'async/await s)
                (list 'if
                  (list 'and
                    (list 'channel/closed? ch)
                    (list 'nil? (list 'channel/recv ch)))
                  total
                  -1))))
          sum)))))

;; channel/close wakes a parked receiver with nil (the closed-and-empty
;; sentinel). The optional sleep varies WHEN the close lands: with it the
;; receiver has parked; without it the close reaches the channel before the
;; receiver runs. Either way the recv settles with nil.
(define (gen-async-chan-closewake env depth)
  (let* ((ch (gensym "ch"))
         (r (gensym "r"))
         (surv (gen-int env (- depth 1))))
    (mk
      (list 'let
        (list (list ch (list 'channel/new (rng-range! 1 3))))
        (cons 'let
          (cons (list (list r (list 'async (list 'channel/recv ch))))
            (append
              (if (rng-bool!) (list (list 'async/sleep (rng-int! 3))) (list))
              (list
                (list 'channel/close ch)
                (list 'if (list 'nil? (list 'async/await r)) (gf surv) -1))))))
      (gv surv))))

;; channel/close wakes a parked sender by failing its send: the task rejects
;; with the closed-send error and awaiting it raises, caught as a marker int.
;; The marker is deterministic whether the close lands before the task's first
;; send or while the task is parked on a full capacity-1 buffer.
(define (gen-async-chan-closesend env depth)
  (let ((ch (gensym "ch"))
        (s (gensym "s"))
        (mark (rng-range! 100 999))
        (a (rng-range! -9 9))
        (b (rng-range! -9 9)))
    (mk
      (list 'let
        (list (list ch (list 'channel/new 1)))
        (cons 'let
          (cons
            (list
              (list s
                (list 'async
                  (list 'channel/send ch a)
                  (list 'channel/send ch b)
                  0)))
            (append
              (if (rng-bool!) (list (list 'async/sleep (rng-int! 3))) (list))
              (list
                (list 'channel/close ch)
                (list 'try (list 'async/await s) (list 'catch 'e mark)))))))
      mark)))

;; channel/try-recv, only in deterministic positions: a miss on a fresh channel
;; (nil), or a hit right after the sender was awaited (the value is buffered).
(define (gen-async-tryrecv env depth)
  (let ((ch (gensym "ch"))
        (v (gen-int env (- depth 1))))
    (if (rng-bool!)
      (mk
        (list 'let
          (list (list ch (list 'channel/new (rng-range! 1 3))))
          (list 'if (list 'nil? (list 'channel/try-recv ch)) (gf v) -1))
        (gv v))
      (mk
        (list 'let
          (list (list ch (list 'channel/new (rng-range! 1 3))))
          (list 'async/await (list 'async (list 'channel/send ch (gf v))))
          (list 'channel/try-recv ch))
        (gv v)))))

;; Spawn tree: spawn `fan` children concurrently, then await each and sum.
;; Child bodies recurse into a smaller tree, so spawns nest inside spawned
;; tasks (tree depth <= 3). Occasionally an extra DETACHED child is spawned
;; and never awaited: its body is value-neutral (small sleep, then 0), so it
;; only seeds leftover runtime state alongside the surrounding program —
;; leftover unobserved state is what bug shape 1 (orphaned pending stages)
;; feeds on.
(define (spawn-tree-expr env depth)
  (if (<= depth 0)
    (gen-int env 0)
    (let ((fan (rng-range! 1 3)))
      (let loop ((i 0) (binds (list)) (names (list)) (sum 0))
        (if (< i fan)
          (let ((child (spawn-tree-expr env (- depth 1)))
                (p (gensym "p")))
            (loop (+ i 1)
              (cons (list p (mk-task (list (gf child)))) binds)
              (cons p names)
              (+ sum (gv child))))
          (let ((awaits (map (lambda (nm) (list 'async/await nm)) (reverse names)))
                (detach
                  (if (= 0 (rng-int! 3))
                    (list (list 'async (list 'async/sleep (rng-int! 4)) 0))
                    (list))))
            (mk
              (cons 'let
                (cons (reverse binds) (append detach (list (cons '+ awaits)))))
              sum)))))))

(define (gen-async-spawn-tree env depth)
  (spawn-tree-expr env (min (max depth 1) 3)))

;; Cancel a task parked in each wait kind: virtual timer (async/sleep), channel
;; recv on a never-sent channel, channel send into a full capacity-1 buffer,
;; and an offloaded blocking sleep. The root optionally parks first so the
;; target is genuinely parked when the cancel lands (cancel-during-park) rather
;; than still queued (cancel-before-start); both settle the promise as
;; cancelled. Oracle reads are post-settle only: await under try must give the
;; :cancelled condition, and async/cancelled? must be #t after that await. The
;; surviving computation's value is the program's value.
;; The blocking-sleep target uses 1500 ms, not a forever value: the executor
;; worker cannot be interrupted mid-sleep, so a cancelled 60 s blocking sleep
;; would pin an executor thread for 60 s even though the promise settles
;; immediately (verified against the binary; the ~2 s shutdown grace at
;; process exit is the visible symptom).
(define (gen-async-cancel env depth)
  (let* ((kind (rng-int! 4))
         (ch (gensym "ch"))
         (p (gensym "p"))
         (m (gensym "m"))
         (surv (gen-int env (- depth 1)))
         (target
           (cond
             ((= kind 0) (list 'async (list 'async/sleep 60000) 1))
             ((= kind 1) (list 'async (list 'channel/recv ch)))
             ((= kind 2)
               (list 'async
                 (list 'channel/send ch 1)
                 (list 'channel/send ch 2)
                 0))
             (else (list 'async (list 'sleep 1500) 2)))))
    (mk
      (list 'let
        (list (list ch (list 'channel/new 1)))
        (cons 'let
          (cons (list (list p target))
            (append
              (if (rng-bool!) (list (list 'async/sleep (rng-int! 3))) (list))
              (list
                (list 'async/cancel p)
                (list 'let
                  (list
                    (list m
                      (list 'try
                        (list 'async/await p)
                        (list 'catch 'e (list ':type 'e)))))
                  (list 'if
                    (list 'and
                      (list '= m ':cancelled)
                      (list 'async/cancelled? p))
                    (gf surv)
                    -1)))))))
      (gv surv))))

;; Owned-combinator failure: async/map or async/pool-map over 1..n where
;; EXACTLY ONE item makes the worker throw a marker int. The owned combinator
;; settles fail-fast with that error and cancels the sibling workers
;; (__owned-all + __cancel-all); catching it yields the marker.
(define (gen-async-owned-fail env depth)
  (let* ((n (rng-range! 2 6))
         (bad (rng-range! 1 n))
         (mark (rng-range! 1000 9999))
         (x (gensym "x"))
         (items (cons 'list (range 1 (+ n 1))))
         (worker
           (list 'lambda
             (list x)
             (list 'if (list '= x bad) (list 'throw mark) x)))
         (call
           (if (rng-bool!)
             (list 'async/map worker items)
             (list 'async/pool-map worker items (rng-range! 1 4)))))
    (mk (list 'try call (list 'catch 'e (list ':value 'e))) mark)))

;; Owned combinators, success path: async/map / async/pool-map with a pure
;; worker over 1..n (deterministic, input-ordered result list; pool-map also
;; exercises the channel-backed semaphore), and async/spawn-all over closed
;; thunks of generated int programs.
(define (gen-async-owned-ok env depth)
  ((rng-pick! (list
    (lambda (env depth)
      (let* ((n (rng-range! 1 8))
             (k (rng-range! -5 5))
             (x (gensym "x"))
             (items (range 1 (+ n 1)))
             (body (cons 'begin (with-sleeps (list (list '+ x k))))))
        (mk (list 'async/map (list 'lambda (list x) body) (cons 'list items))
          (map (lambda (i) (+ i k)) items))))
    (lambda (env depth)
      (let* ((n (rng-range! 1 8))
             (w (rng-range! 1 4))
             (x (gensym "x"))
             (items (range 1 (+ n 1)))
             (body (cons 'begin (with-sleeps (list (list '* x x))))))
        (mk
          (list 'async/pool-map (list 'lambda (list x) body) (cons 'list items) w)
          (map (lambda (i) (* i i)) items))))
    (lambda (env depth)
      (let ((kk (rng-range! 1 3)))
        (let loop ((i 0) (thunks (list)) (vals (list)))
          (if (< i kk)
            (let ((t (gen-int env (- depth 1))))
              (loop (+ i 1)
                (cons (list 'lambda (list) (gf t)) thunks)
                (cons (gv t) vals)))
            (mk (list 'async/spawn-all (cons 'list (reverse thunks)))
              (reverse vals)))))))
    ) env depth))

;; Insert x into xs at index i (0 <= i <= (length xs)).
(define (insert-at xs i x)
  (append (take i xs) (cons x (drop i xs))))

;; Select-like: async/race over exactly one settleable task and 1-3 losers
;; parked forever (recv on a never-sent channel, or a 60 s virtual timer), so
;; the winner is deterministic by construction whatever its list position. The
;; observational race leaves losers running, so the root cancels them
;; explicitly; the owned variant (async/race-owned, over thunks) cancels them
;; itself. The winner body may still sleep a few ms — no loser can ever settle
;; first. There is deliberately no timed-race variant: two timers racing is a
;; wall-clock bound, and those are untrustworthy under load
;; (docs/bugs/2026-07-28-sibling-interleaving-tests-are-load-sensitive.md).
(define (gen-async-race env depth)
  (let* ((ch (gensym "ch"))
         (w (gen-int env (- depth 1)))
         (nl (rng-range! 1 3))
         (owned (rng-bool!)))
    (let loop ((i 0) (losers (list)))
      (if (< i nl)
        (loop (+ i 1)
          (cons
            (if (rng-bool!)
              (if owned
                (list 'lambda (list) (list 'channel/recv ch))
                (list 'async (list 'channel/recv ch)))
              (if owned
                (list 'lambda (list) (list 'async/sleep 60000) 0)
                (list 'async (list 'async/sleep 60000) 0)))
            losers))
        (if owned
          (let* ((winner (list 'lambda (list) (cons 'begin (with-sleeps (list (gf w))))))
                 (thunks (insert-at losers (rng-int! (+ nl 1)) winner)))
            (mk
              (list 'let
                (list (list ch (list 'channel/new 1)))
                (list 'async/race-owned (cons 'list thunks)))
              (gv w)))
          (let* ((names
                   (let nloop ((j 0) (acc (list)))
                     (if (< j nl) (nloop (+ j 1) (cons (gensym "l") acc)) acc)))
                 (wname (gensym "w"))
                 (binds (map (lambda (nm t) (list nm t)) names losers))
                 (wtask (mk-task (list (gf w))))
                 (pos (rng-int! (+ nl 1)))
                 (all-binds (insert-at binds pos (list wname wtask)))
                 (all-names (insert-at names pos wname))
                 (v (gensym "v")))
            (mk
              (list 'let
                (list (list ch (list 'channel/new 1)))
                (list 'let
                  all-binds
                  (cons 'let
                    (cons
                      (list (list v (list 'async/race (cons 'list all-names))))
                      (append
                        (map (lambda (nm) (list 'async/cancel nm)) names)
                        (list v))))))
              (gv w))))))))

;; async/with-timeout: either the body settles immediately (value wins; the
;; deadline is 60 s so no wall-clock bound is asserted) or the body parks
;; forever on a never-sent channel (the 1-5 ms deadline wins, the child is
;; cancelled, and the :timeout condition is caught as a marker).
(define (gen-async-with-timeout env depth)
  (let ((ch (gensym "ch"))
        (body (gen-int env (- depth 1))))
    (if (rng-bool!)
      (mk
        (list 'async/with-timeout
          60000
          (list 'lambda (list) (cons 'begin (with-sleeps (list (gf body))))))
        (gv body))
      (let ((mark (rng-range! 100 999)))
        (mk
          (list 'let
            (list (list ch (list 'channel/new 1)))
            (list 'try
              (list 'async/with-timeout
                (rng-range! 1 5)
                (list 'lambda (list) (list 'channel/recv ch)))
              (list 'catch
                'e
                (list 'if (list '= (list ':type 'e) ':timeout) mark -1))))
          mark)))))

;; Causal ordering (park-vs-pin): the root parks — virtual timer or offloaded
;; blocking sleep — while a zero-delay sibling sends its marker; the root sends
;; its own marker after resuming. Draining must observe sibling-before-root.
;; This is the load-safe oracle shape from the sibling-interleaving write-up:
;; a causal ordering, not a wall-clock bound.
(define (gen-async-causal env depth)
  (let* ((out (gensym "out"))
         (sib (gensym "sib"))
         (surv (gen-int env (- depth 1)))
         (park
           (if (rng-bool!)
             (list 'async/sleep (rng-range! 1 5))
             (list 'sleep (rng-range! 1 3)))))
    (mk
      (list 'let
        (list (list out (list 'channel/new 8)))
        (list 'let
          (list (list sib (list 'async (list 'channel/send out 1))))
          park
          (list 'channel/send out 2)
          (list 'async/await sib)
          (list 'if
            (list 'and
              (list '= 1 (list 'channel/recv out))
              (list '= 2 (list 'channel/recv out)))
            (gf surv)
            -1)))
      (gv surv))))

;; OS temp dir with a trailing slash, for the offload-leaf files.
(define *tmp-dir*
  (let ((d (env "TMPDIR")))
    (if (null? d)
      "/tmp/"
      (if (string/ends-with? d "/") d (string-append d "/")))))

;; Counter making every offload production in a run use a distinct file, even
;; when several nest inside one generated program (same seed). Deterministic:
;; generation order is fixed by the seed.
(define *file-ctr* 0)

;; Offload leaves: file/write then file/read of a per-seed file under the OS
;; temp dir, inside a task — puts External waits (the executor's blocking tier)
;; and their completion path in play. Path and content both derive from
;; seed + counter, so the read-back value is deterministic and even a path
;; collision between concurrent fuzzer runs writes identical bytes.
;; Cancel-during-offload is covered by gen-async-cancel's blocking-sleep
;; target (a park the generator controls); file-op cancellation timing is racy
;; by nature, so file tasks are never cancelled.
(define (gen-async-offload env depth)
  (set! *file-ctr* (+ *file-ctr* 1))
  (let* ((stem
           (string-append
             "sema-grammar-fuzz-"
             (number->string *cur-seed*)
             "-"
             (number->string *file-ctr*)))
         (path (string-append *tmp-dir* stem ".txt"))
         (r (gensym "r")))
    (mk
      (list 'let
        (list
          (list r
            (list 'async/await
              (mk-task
                (list (list 'file/write path stem) (list 'file/read path))))))
        (list 'file/delete path)
        r)
      stem)))

;; Dispatch for the gated async productions.
(define (gen-async env depth)
  (if (<= depth 0)
    (gen-async-leaf env)
    ((rng-pick! (list
      (gen-thunk gen-async-chan-pipeline)
      (gen-thunk gen-async-chan-recvfirst)
      (gen-thunk gen-async-chan-fanin)
      (gen-thunk gen-async-chan-close)
      (gen-thunk gen-async-chan-closewake)
      (gen-thunk gen-async-chan-closesend)
      (gen-thunk gen-async-tryrecv)
      (gen-thunk gen-async-spawn-tree)
      (gen-thunk gen-async-cancel)
      (gen-thunk gen-async-owned-fail)
      (gen-thunk gen-async-owned-ok)
      (gen-thunk gen-async-race)
      (gen-thunk gen-async-with-timeout)
      (gen-thunk gen-async-causal)
      (gen-thunk gen-async-offload)
      )) env depth)))

;; ── metamorphic / differential laws (independent oracle for native ops) ──────
;; The plain value oracle computes `expected` by calling the SAME builtin the
;; form uses, so a bug in a native op (reverse/sort/map/filter/…) masks itself —
;; both sides agree on the wrong answer. Each law here is instead a *theorem*
;; whose expected value is the literal #t, cross-checking an op against an
;; independent computation. A broken op makes the two sides disagree → the law
;; evaluates to #f ≠ #t → caught.
(define (law form) (mk form #t)) ; a law: must evaluate to #t on a correct VM

(define (gen-law env depth)
  ((rng-pick! (list
    ;; reverse == fold-cons
    (lambda (env depth)
      (let ((l (gen-ilist env (- depth 1))))
        (law
          (list '=
            (list 'reverse (gf l))
            (list 'foldl
              (list 'lambda (list 'a 'x) (list 'cons 'x 'a))
              (list 'list)
              (gf l))))))
    ;; last L == first (reverse L)   [nonempty]
    (lambda (env depth)
      (let* ((l (gen-ilist env (- depth 1))) (lv (gv l)))
        (if (> (length lv) 0)
          (law
            (list '= (list 'last (gf l)) (list 'first (list 'reverse (gf l)))))
          (law #t))))
    ;; append (take n L) (drop n L) == L
    (lambda (env depth)
      (let* ((l (gen-ilist env (- depth 1)))
             (n (rng-int! (+ 1 (length (gv l))))))
        (law
          (list '=
            (list 'append (list 'take n (gf l)) (list 'drop n (gf l)))
            (gf l)))))
    ;; length (append A B) == length A + length B
    (lambda (env depth)
      (let ((a (gen-ilist env (- depth 1))) (b (gen-ilist env (- depth 1))))
        (law
          (list '=
            (list 'length (list 'append (gf a) (gf b)))
            (list '+ (list 'length (gf a)) (list 'length (gf b)))))))
    ;; sort L == sort (reverse L)   (sort is order-independent)
    (lambda (env depth)
      (let ((l (gen-ilist env (- depth 1))))
        (law (list '= (list 'sort (gf l)) (list 'sort (list 'reverse (gf l)))))))
    ;; sum (sort L) == sum L        (sort preserves the multiset)
    (lambda (env depth)
      (let ((l (gen-ilist env (- depth 1))))
        (law
          (list '=
            (list 'foldl '+ 0 (list 'sort (gf l)))
            (list 'foldl '+ 0 (gf l))))))
    ;; length L == #even + #odd
    (lambda (env depth)
      (let ((l (gen-ilist env (- depth 1))))
        (law
          (list '=
            (list 'length (gf l))
            (list '+
              (list 'length (list 'filter 'even? (gf l)))
              (list 'length (list 'filter 'odd? (gf l))))))))
    ;; map (+ k) L == reverse (fold-cons (+ k) L)
    (lambda (env depth)
      (let ((l (gen-ilist env (- depth 1))) (k (rng-range! -5 5)))
        (law
          (list '=
            (list 'map (list 'lambda (list 'x) (list '+ 'x k)) (gf l))
            (list 'reverse
              (list 'foldl
                (list 'lambda (list 'a 'x) (list 'cons (list '+ 'x k) 'a))
                (list 'list)
                (gf l)))))))
    ;; (first (cons X L)) == X  &  length grows by 1
    (lambda (env depth)
      (let ((x (gen-int env (- depth 1))) (l (gen-ilist env (- depth 1))))
        (law
          (list 'and
            (list '= (list 'first (list 'cons (gf x) (gf l))) (gf x))
            (list '=
              (list 'length (list 'cons (gf x) (gf l)))
              (list '+ 1 (list 'length (gf l))))))))
    ;; string-length (string-append A B) == lenA + lenB
    (lambda (env depth)
      (let ((a (gen-str env (- depth 1))) (b (gen-str env (- depth 1))))
        (law
          (list '=
            (list 'string-length (list 'string-append (gf a) (gf b)))
            (list '+
              (list 'string-length (gf a))
              (list 'string-length (gf b)))))))
    ;; string/reverse involution + length
    (lambda (env depth)
      (let ((s (gen-str env (- depth 1))))
        (law
          (list 'and
            (list '=
              (list 'string/reverse (list 'string/reverse (gf s)))
              (gf s))
            (list '=
              (list 'string-length (list 'string/reverse (gf s)))
              (list 'string-length (gf s)))))))
    ;; get (assoc M K V) K == V
    (lambda (env depth)
      (let ((m (gen-map-v env (- depth 1)))
            (k (rng-pick! *map-keys*))
            (v (gen-int env (- depth 1))))
        (law (list '= (list 'get (list 'assoc (gf m) k (gf v)) k) (gf v)))))
    ;; count (assoc M K V) law
    (lambda (env depth)
      (let ((m (gen-map-v env (- depth 1)))
            (k (rng-pick! *map-keys*))
            (v (gen-int env (- depth 1))))
        (law
          (list '=
            (list 'count (list 'assoc (gf m) k (gf v)))
            (list 'if
              (list 'contains? (gf m) k)
              (list 'count (gf m))
              (list '+ 1 (list 'count (gf m))))))))
    ;; distributivity: a*(b+c) == a*b + a*c
    (lambda (env depth)
      (let ((a (gen-int env (- depth 1)))
            (b (gen-int env (- depth 1)))
            (cc (gen-int env (- depth 1))))
        (law
          (list '=
            (list '* (gf a) (list '+ (gf b) (gf cc)))
            (list '+ (list '* (gf a) (gf b)) (list '* (gf a) (gf cc)))))))
    ;; rational literal commutativity — exercises the `a/b` reader literal
    ;; and its arithmetic end-to-end through the compile/VM oracle.
    (lambda (env depth)
      (let ((r (gen-rational-atom)))
        (law (list '= (list '+ r 1) (list '+ 1 r)))))
    ;; complex literal commutativity — exercises the `a+bi` reader literal
    ;; end-to-end through the compile/VM oracle.
    (lambda (env depth)
      (let ((z (gen-complex-atom)))
        (law (list '= (list '+ z 1) (list '+ 1 z)))))
    ;; vector->list preserves count
    (lambda (env depth)
      (let ((v (gen-vec env (- depth 1))))
        (law
          (list '=
            (list 'count (list 'vector->list (gf v)))
            (list 'count (gf v)))))))
    ) env depth))

;; ── float ──────────────────────────────────────────────────────────────────
;; Magnitudes kept small so +/-/* never overflow to inf and never produce NaN;
;; float `=` is exact, and expected is computed with the same ops, so it holds.
(define (gen-flt env depth)
  (if (<= depth 0)
    (gen-flt-leaf env)
    ((rng-pick! (list
      ;; slots 0-2: leaf (weight 3 of 9)
      (lambda (env depth) (gen-flt-leaf env))
      (lambda (env depth) (gen-flt-leaf env))
      (lambda (env depth) (gen-flt-leaf env))
      (lambda (env depth) (gen-flt-bin '+ env depth +))
      (lambda (env depth) (gen-flt-bin '- env depth -))
      (lambda (env depth) (gen-flt-bin '* env depth *))
      (gen-thunk gen-flt-unary)
      (gen-thunk gen-flt-if)
      (gen-thunk gen-flt-let)
      )) env depth)))

(define (gen-flt-leaf env)
  (let ((r (maybe-ref env 'float)))
    (if (and (not (null? r)) (rng-bool!))
      r
      (let ((f (/ (rng-range! -400 400) 8.0))) (mk f f)))))

(define (gen-flt-bin op env depth f)
  (let ((a (gen-flt env (- depth 1))) (b (gen-flt env (- depth 1))))
    (mk (list op (gf a) (gf b)) (f (gv a) (gv b)))))

(define (gen-flt-unary env depth)
  (let ((a (gen-flt env (- depth 1))))
    (mk (list '- (gf a)) (- (gv a)))))

(define (gen-flt-if env depth)
  (let ((c (gen-bool env (- depth 1)))
        (t (gen-flt env (- depth 1)))
        (e (gen-flt env (- depth 1))))
    (mk (list 'if (gf c) (gf t) (gf e)) (if (gv c) (gv t) (gv e)))))

(define (gen-flt-let env depth)
  (let* ((v (gensym "f"))
         (init (gen-flt env (- depth 1)))
         (env2 (cons (list v (gv init) 'float) env))
         (body (gen-flt env2 (- depth 1))))
    (mk (list 'let (list (list v (gf init))) (gf body)) (gv body))))

(define (gen-bool-floatcmp env depth)
  (let ((a (gen-flt env (- depth 1)))
        (b (gen-flt env (- depth 1)))
        (c (rng-int! 3)))
    (cond
      ((= c 0) (mk (list '< (gf a) (gf b)) (< (gv a) (gv b))))
      ((= c 1) (mk (list '> (gf a) (gf b)) (> (gv a) (gv b))))
      (else (mk (list '= (gf a) (gf a)) (= (gv a) (gv a)))))))

;; ── string ──────────────────────────────────────────────────────────────────
;; Forms are eval'd directly (not printed→read), so any content is fine; `=` is
;; exact. Expected computed with the same string ops.
(define *str-chars* "abcXYZ012 _-")

(define (rand-string)
  (let ((len (rng-int! 6)))
    (let loop ((i 0) (acc ""))
      (if (>= i len)
        acc
        (let ((k (rng-int! (string-length *str-chars*))))
          (loop (+ i 1) (string-append acc (substring *str-chars* k (+ k 1)))))))))

(define (gen-str env depth)
  (if (<= depth 0)
    (gen-str-leaf env)
    ((rng-pick! (list
      ;; slots 0-2: leaf (weight 3 of 11)
      (lambda (env depth) (gen-str-leaf env))
      (lambda (env depth) (gen-str-leaf env))
      (lambda (env depth) (gen-str-leaf env))
      (gen-thunk gen-str-append)
      (gen-thunk gen-str-sub)
      (lambda (env depth) (gen-str-case env depth #t))
      (lambda (env depth) (gen-str-case env depth #f))
      (gen-thunk gen-str-reverse)
      (gen-thunk gen-str-repeat)
      (gen-thunk gen-str-numstr)
      (gen-thunk gen-str-let)
      )) env depth)))

(define (gen-str-leaf env)
  (let ((r (maybe-ref env 'string)))
    (if (and (not (null? r)) (rng-bool!))
      r
      (let ((s (rand-string))) (mk s s)))))

(define (gen-str-append env depth)
  (let ((a (gen-str env (- depth 1))) (b (gen-str env (- depth 1))))
    (mk (list 'string-append (gf a) (gf b)) (string-append (gv a) (gv b)))))

(define (gen-str-sub env depth)
  (let* ((s (gen-str env (- depth 1))) (sv (gv s)) (n (string-length sv)))
    (if (= n 0)
      (mk (gf s) sv)
      (let* ((start (rng-int! n)) (end (rng-range! start n)))
        (mk (list 'substring (gf s) start end) (substring sv start end))))))

(define (gen-str-case env depth up)
  (let ((s (gen-str env (- depth 1))))
    (if up
      (mk (list 'string-upcase (gf s)) (string-upcase (gv s)))
      (mk (list 'string-downcase (gf s)) (string-downcase (gv s))))))

(define (gen-str-reverse env depth)
  (let ((s (gen-str env (- depth 1))))
    (mk (list 'string/reverse (gf s)) (string/reverse (gv s)))))

(define (gen-str-let env depth)
  (let* ((v (gensym "s"))
         (init (gen-str env (- depth 1)))
         (env2 (cons (list v (gv init) 'string) env))
         (body (gen-str env2 (- depth 1))))
    (mk (list 'let (list (list v (gf init))) (gf body)) (gv body))))

;; ── vector (of ints; immutable) ─────────────────────────────────────────────
(define (gen-vec env depth)
  (cond
    ((and (> depth 0) (= 0 (rng-int! 4)))
      ;; (list->vector <list-expr>) — exercises the conversion
      (let ((l (gen-ilist env (- depth 1))))
        (mk (list 'list->vector (gf l)) (list->vector (gv l)))))
    (else
      (let ((r (maybe-ref env 'vec)))
        (if (and (not (null? r)) (rng-bool!))
          r
          (let ((k (rng-int! 5)))
            (let loop ((i 0) (fs (list)) (vs (list)))
              (if (>= i k)
                (mk (cons 'vector (reverse fs)) (list->vector (reverse vs)))
                (let ((n (rng-range! -9 9)))
                  (loop (+ i 1) (cons n fs) (cons n vs)))))))))))

;; ── map (keyword -> int) ─────────────────────────────────────────────────────
(define *map-keys* (list :a :b :c :d :e))

(define (gen-map-v env depth)
  (if (<= depth 0)
    (gen-map-leaf env)
    ((rng-pick! (list
      (lambda (env depth) (gen-map-leaf env))  ; 0
      (lambda (env depth) (gen-map-leaf env))  ; 1
      (lambda (env depth) (gen-map-leaf env))  ; 2
      (gen-thunk gen-map-assoc)                ; 3
      (gen-thunk gen-map-dissoc)               ; 4
      (gen-thunk gen-map-merge)                ; 5
      (lambda (env depth) (gen-map-leaf env))  ; 6 = else -> leaf
      )) env depth)))

(define (gen-map-leaf env)
  (let ((r (maybe-ref env 'map)))
    (if (and (not (null? r)) (rng-bool!))
      r
      ;; build a literal via an assoc chain over distinct keys
      (let ((k (rng-int! 4)))
        (let loop ((i 0) (form {}) (val {}))
          (if (>= i k)
            (mk form val)
            (let ((key (nth *map-keys* i)) (n (rng-range! -9 9)))
              (loop (+ i 1)
                (list 'assoc form key n)
                (assoc val key n)))))))))

(define (gen-map-assoc env depth)
  (let ((m (gen-map-v env (- depth 1)))
        (k (rng-pick! *map-keys*))
        (x (gen-int env (- depth 1))))
    (mk (list 'assoc (gf m) k (gf x)) (assoc (gv m) k (gv x)))))

(define (gen-map-dissoc env depth)
  (let ((m (gen-map-v env (- depth 1))) (k (rng-pick! *map-keys*)))
    (mk (list 'dissoc (gf m) k) (dissoc (gv m) k))))

(define (gen-bool-mapcontains env depth)
  (let ((m (gen-map-v env (- depth 1))) (k (rng-pick! *map-keys*)))
    (mk (list 'contains? (gf m) k) (contains? (gv m) k))))

;; Top-level: pick a result type (int-biased) and generate a closed program.
(define (gen-typed depth)
  (gen-of (rng-pick! *types*) (list) depth))

;; ─────────────────────────────────────────────────────────────────────────
;; Oracles + reporting
;; ─────────────────────────────────────────────────────────────────────────

(define *failures* 0)
(define *cur-seed* 0)
(define *verbose* #f)

(define (report-fail kind form a b)
  (set! *failures* (+ *failures* 1))
  (display "FAIL [")
  (display kind)
  (display "] seed=")
  (display (number->string *cur-seed*))
  (newline)
  (display "  form:     ")
  (display (str form))
  (newline)
  (display "  expected: ")
  (display (str a))
  (newline)
  (display "  actual:   ")
  (display (str b))
  (newline)
  (display "  reproduce: ")
  (when *async* (display "SEMA_FUZZ_ASYNC=1 "))
  (display "SEMA_FUZZ_SEED=")
  (display (number->string *cur-seed*))
  (display " SEMA_FUZZ_COUNT=1")
  (newline)
  #f)

(define (check-roundtrip d)
  ;; Wrap in a list so the *readable* printer path is exercised (Sema's `str`
  ;; renders a bare top-level string as its raw contents — display semantics —
  ;; but quotes strings nested inside a container, which is the readable form
  ;; programs are actually printed with). This tests Sema's printer against
  ;; Sema's reader, not our harness against either.
  (let* ((wrapped (list d))
         (s (str wrapped)))
    (try
      (let ((d2 (read s)))
        (if (= wrapped d2)
          #t
          (report-fail "roundtrip" wrapped s d2)))
      (catch e (report-fail "roundtrip-read-error" wrapped s e)))))

;; ── confluent-value twin oracle (async mode only) ──────────────────────────
;; The value oracle's `expected` comes from the generation-time model, so a bug
;; in the model itself could agree with a buggy runtime. For the mechanically
;; de-asyncable constructs the checker derives an independent sequential twin
;; of the whole generated program and requires it to evaluate to the same
;; expected value (the async form already matched, so async form, sequential
;; twin, and model must all agree). The walker is a pure structural rewrite —
;; no RNG, no gensym — so the seed-to-program mapping is untouched:
;;
;;   (async B ...)                 -> (begin B ...)
;;   (async/await X)               -> X
;;   (async/all (list E ...))      -> (list E ...)
;;   (async/map F Xs)              -> (map F Xs)
;;   (async/pool-map F Xs W)       -> (map F Xs)
;;   (async/spawn-all (list T ...)) -> (list (T) ...)
;;   (async/sleep K), (sleep K)    -> nil   (generated only in effect position)
;;
;; Anything without a mechanical sequential twin blocks the whole program from
;; twinning (the walker throws :twin-blocked): every channel/* op, every other
;; async/* op, the offload file ops, and a `throw` inside an owned combinator's
;; arguments (fail-fast cancels siblings; plain map does not). See the oracle
;; class table above the async productions.

(define *twin-checks* 0)  ; programs where a twin was derived and evaluated
(define *twin-blocked* 0) ; programs skipped: a non-mechanical construct
;; Rewrite counters per twin-class production family, keyed by symbol so a
;; snapshot/restore is one map and a bump is one call instead of six parallel
;; globals. Labels: :async :await :all :map :pool-map :spawn-all.
(define *tw-counts* {})

;; Count one rewrite of the `k` twin class.
(define (tw-bump! k)
  (set! *tw-counts* (assoc *tw-counts* k (+ 1 (get *tw-counts* k 0)))))

(define (twin-blocked!) (throw :twin-blocked))

;; #t when a throw form occurs anywhere inside f.
(define (contains-throw? f)
  (if (pair? f)
    (if (= (first f) 'throw)
      #t
      (let loop ((xs f))
        (if (pair? xs)
          (if (contains-throw? (first xs)) #t (loop (rest xs)))
          #f)))
    #f))

;; Non-mechanical head symbols. The prefix rules keep future productions safe
;; by default: an async/* or channel/* op the walker does not rewrite above
;; blocks the program instead of being silently mistwinned.
(define (twin-blocker? h)
  (and (symbol? h)
    (let ((s (symbol->string h)))
      (or (string/starts-with? s "channel/")
        (string/starts-with? s "async/")
        (= s "file/write")
        (= s "file/read")
        (= s "file/delete")))))

;; The literal (list E ...) argument of async/all: each element is an
;; (async ...) form the recursion rewrites to its body value. Any other
;; argument shape is not mechanical.
(define (twin-all-arg arg)
  (if (and (pair? arg) (= (first arg) 'list))
    (cons 'list (map twin (rest arg)))
    (twin-blocked!)))

;; The literal (list T ...) thunk argument of async/spawn-all: the twin calls
;; each thunk in order.
(define (twin-spawn-all-arg arg)
  (if (and (pair? arg) (= (first arg) 'list))
    (cons 'list (map (lambda (th) (list (twin th))) (rest arg)))
    (twin-blocked!)))

(define (twin form)
  (if (not (pair? form))
    form
    (let ((h (first form)))
      (cond
        ;; value-neutral sleeps: the generator emits them only in effect position
        ((= h 'async/sleep) nil)
        ((= h 'sleep) nil)
        ((= h 'async)
          (begin
            (tw-bump! :async)
            (cons 'begin (map twin (rest form)))))
        ((= h 'async/await)
          (begin
            (tw-bump! :await)
            (twin (nth form 1))))
        ((= h 'async/all)
          (begin
            (tw-bump! :all)
            (twin-all-arg (nth form 1))))
        ((= h 'async/map)
          (if (contains-throw? form)
            (twin-blocked!)
            (begin
              (tw-bump! :map)
              (list 'map (twin (nth form 1)) (twin (nth form 2))))))
        ((= h 'async/pool-map)
          (if (contains-throw? form)
            (twin-blocked!)
            (begin
              (tw-bump! :pool-map)
              (list 'map (twin (nth form 1)) (twin (nth form 2))))))
        ((= h 'async/spawn-all)
          (if (contains-throw? form)
            (twin-blocked!)
            (begin
              (tw-bump! :spawn-all)
              (twin-spawn-all-arg (nth form 1)))))
        ((twin-blocker? h) (twin-blocked!))
        (else (map twin form))))))

;; Derive and evaluate the twin. Counted only when the rewrite changed the
;; form: a program with no async construct twins to itself and proves nothing.
;; On a blocked walk the rewrite counters roll back to their pre-walk values,
;; so the stat line counts only rewrites whose twin was actually evaluated.
(define (check-twin form expected)
  (if (not *async*)
    #t
    (let ((saved *tw-counts*))
      (try
        (let ((tw (twin form)))
          (if (= tw form)
            #t
            (begin
              (set! *twin-checks* (+ *twin-checks* 1))
              (try
                (let ((got (eval tw)))
                  (if (= expected got)
                    #t
                    (report-fail "twin-oracle" tw expected got)))
                (catch e (report-fail "twin-eval-error" tw expected e))))))
        (catch e
          (if (= (:value e) :twin-blocked)
            (begin
              (set! *tw-counts* saved)
              (set! *twin-blocked* (+ *twin-blocked* 1))
              #t)
            ;; an error in the walker itself — report it, never mask it
            (report-fail "twin-derivation-error" form expected e)))))))

(define (check-oracle pair)
  (let ((form (gf pair))
        (expected (gv pair)))
    (try
      (let ((got (eval form)))
        (if (= expected got)
          (check-twin form expected)
          (report-fail "oracle" form expected got)))
      (catch e (report-fail "oracle-eval-error" form expected e)))))

;; ─────────────────────────────────────────────────────────────────────────
;; Config
;; ─────────────────────────────────────────────────────────────────────────

(define (cfg name default)
  (let ((v (env name)))
    (if (null? v) default v)))

(define (cfg-int name default)
  (let ((v (env name)))
    (if (null? v) default (string->number v))))

(define base-seed (cfg-int "SEMA_FUZZ_SEED" 0))
(define iterations (cfg-int "SEMA_FUZZ_COUNT" 200))
(define max-depth (cfg-int "SEMA_FUZZ_DEPTH" 4))
(define mode (cfg "SEMA_FUZZ_MODE" "check"))
(define out-file (env "SEMA_FUZZ_OUT"))
(define crash-file (env "SEMA_FUZZ_CRASH_FILE"))
(set! *verbose* (= "1" (cfg "SEMA_FUZZ_VERBOSE" "0")))

;; ─────────────────────────────────────────────────────────────────────────
;; Modes
;; ─────────────────────────────────────────────────────────────────────────

(define (run-check)
  (display "grammar-fuzz: check  seed=")
  (display (number->string base-seed))
  (display " count=")
  (display (number->string iterations))
  (display " depth=")
  (display (number->string max-depth))
  (newline)
  (let loop ((i 0))
    (if (>= i iterations)
      (finish)
      (let ((seed (+ base-seed i)))
        (set! *cur-seed* seed)
        (when (not (null? crash-file))
          (file/write crash-file (number->string seed)))
        (rng-seed! seed)
        ;; Per-iteration reset: offload file paths must depend only on the seed,
        ;; not on how many iterations ran before it, or a single-seed repro
        ;; would generate a different program than the batch run.
        (set! *file-ctr* 0)
        ;; round-trip property on a random datum
        (let ((d (gen-datum max-depth)))
          (let ((ok (check-roundtrip d)))
            (when (and *verbose* ok)
              (display "ok roundtrip: ")
              (display (str d))
              (newline))))
        ;; value oracle on a typed program (same RNG stream continues)
        (let ((p (gen-typed max-depth)))
          (let ((ok (check-oracle p)))
            (when (and *verbose* ok)
              (display "ok oracle: ")
              (display (str (gf p)))
              (display " = ")
              (display (str (gv p)))
              (newline))))
        (loop (+ i 1))))))

(define (finish)
  ;; success: clear the crash breadcrumb so the driver knows we exited cleanly
  (when (not (null? crash-file)) (file/write crash-file "ok"))
  (newline)
  ;; Async mode: prove the twin oracle ran. checked= is the number of programs
  ;; whose sequential twin was derived and evaluated (a zero here would mean
  ;; the oracle passed vacuously); non-mechanical= is the number skipped
  ;; because the program contained a construct with no mechanical twin. The
  ;; rewrite counts show every twin-class production family was exercised.
  (when *async*
    (display "twin-oracle: checked=")
    (display (number->string *twin-checks*))
    (display " non-mechanical=")
    (display (number->string *twin-blocked*))
    (display " rewrites: async=")
    (display (number->string (get *tw-counts* :async 0)))
    (display " await=")
    (display (number->string (get *tw-counts* :await 0)))
    (display " all=")
    (display (number->string (get *tw-counts* :all 0)))
    (display " map=")
    (display (number->string (get *tw-counts* :map 0)))
    (display " pool-map=")
    (display (number->string (get *tw-counts* :pool-map 0)))
    (display " spawn-all=")
    (display (number->string (get *tw-counts* :spawn-all 0)))
    (newline))
  (if (= *failures* 0)
    (begin
      (display "PASS: ")
      (display (number->string iterations))
      (display " iterations, 0 failures")
      (newline)
      (exit 0))
    (begin
      (display "FAILURES: ")
      (display (number->string *failures*))
      (newline)
      (exit 1))))

;; Render a generated program in read syntax. A program that is a bare string
;; literal needs `~s` (quoted + escaped): `str` renders a top-level string in
;; display form, which cannot be read back. Every other program is a form
;; whose `str` already prints nested strings readably.
(define (program->source f)
  (if (string? f) (format "~s" f) (str f)))

(define (run-emit)
  (let loop ((i 0) (acc (list)))
    (if (>= i iterations)
      (let ((text (string/join (reverse acc) "\n")))
        (if (null? out-file)
          (begin
            (display text)
            (newline))
          (begin
            (file/write out-file (string-append text "\n"))
            (display "wrote ")
            (display (number->string iterations))
            (display " programs to ")
            (display out-file)
            (newline))))
      (begin
        ;; Mirror run-check's per-iteration state exactly: same *cur-seed* and
        ;; *file-ctr* (gen-async-offload derives file paths from them), and the
        ;; same RNG stream position — check generates a round-trip datum before
        ;; the typed program, so emit must generate and discard one too, or it
        ;; shows a different program than the one check ran for the seed.
        (set! *cur-seed* (+ base-seed i))
        (rng-seed! (+ base-seed i))
        (set! *file-ctr* 0)
        (gen-datum max-depth)
        (let ((p (gen-typed max-depth)))
          (loop (+ i 1)
            (cons
              (string-append "; seed="
                (number->string (+ base-seed i))
                " => "
                (str (gv p))
                "\n"
                (program->source (gf p)))
              acc)))))))

(if (= mode "emit") (run-emit) (run-check))
